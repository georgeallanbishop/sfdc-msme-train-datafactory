{
	"name": "inbound_acf",
	"properties": {
		"linkedServiceName": {
			"referenceName": "sfdcdataxchange",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"filename": {
				"type": "string"
			},
			"folder": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@dataset().filename",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat('ACF/', dataset().folder)",
					"type": "Expression"
				},
				"container": "inbound"
			},
			"columnDelimiter": "|",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"type": "String"
			}
		]
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}