{
	"name": "export_from_salesforce_OEC_copy1",
	"properties": {
		"activities": [
			{
				"name": "ExportMetadata",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "SetRunDateHour",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "SetRunDateSuffix",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "SetSTDRunDate",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "SetExportFileDatetime",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"wildcardFileName": "oec_export_metadata.csv",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "metadata",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ExtractSalesforce",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "ExportMetadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('ExportMetadata').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "FromSalesforce",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SalesforceSource",
									"query": {
										"value": "@replace(replace(replace(replace(item().Query,'STD_ADFLastUpdateTime', concat(replace(item().LastUpdateTime, ' ','T'), 'Z')), 'STD_ADFEndTime', variables('std_run_date')),'ADFLastUpdateTime', item().LastUpdateTime), 'ADFEndTime', variables('run_datehour'))",
										"type": "Expression"
									},
									"readBehavior": "query"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"dataIntegrationUnits": 4,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "SF_UAT",
									"type": "DatasetReference",
									"parameters": {
										"object": "test"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "inbound_oec_file",
									"type": "DatasetReference",
									"parameters": {
										"file_name": {
											"value": "@concat(item().FileName, '_', variables('run_date_suffix'), '.csv')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "AddSuccessLog",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "FromSalesforce",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "log_content",
								"value": {
									"value": "@concat('export_pipeline', '|', pipeline().TriggerTime, '|', utcnow(), '|', item().SalesforceObject, '|', 'SFTP', '|', concat(item().FileName, '_', variables('run_date_suffix'), '.csv'), '|', 'Export', '|', 'Success', '|', activity('FromSalesforce').output.rowsCopied)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "AddMetadata",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "FromSalesforce",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "processed_metadata",
								"value": {
									"value": "@item()",
									"type": "Expression"
								}
							}
						},
						{
							"name": "AddFailLog",
							"description": "",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "FromSalesforce",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "log_content",
								"value": {
									"value": "@concat('export_pipeline', '|', pipeline().TriggerTime, '|', utcnow(), '|', item().SalesforceObject, '|', 'SFTP', '|', concat(item().FileName, '_', variables('run_date_suffix'), '.csv'), '|', 'Export', '|', 'Fail', '|', '0')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "AddRowCount",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "FromSalesforce",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "file_row_count",
								"value": {
									"value": "@concat(item().FileName, '|', activity('FromSalesforce').output.rowsCopied)",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "SetRunDateHour",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "run_datehour",
					"value": {
						"value": "@formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd HH:00:00')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ExportTransformation",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "ExtractSalesforce",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('processed_metadata')",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "AppendFileName",
							"type": "AppendVariable",
