{
	"name": "master_pipeline_import",
	"properties": {
		"activities": [
			{
				"name": "CheckNewFiles",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "SetCheckStartTime",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "sftp_inbound",
						"type": "DatasetReference",
						"parameters": {
							"env": {
								"value": "@pipeline().globalParameters.env",
								"type": "Expression"
							},
							"folder": "*"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "SftpReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "HasNewFile",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "CheckNewFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(length(activity('CheckNewFiles').output.childItems), 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "prerequisite_pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "delete_pipeline",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "prerequisite_pipeline",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "validation_pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "prerequisite_pipeline",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "validation_pipeline",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"env": {
										"value": "@pipeline().globalParameters.env",
										"type": "Expression"
									},
									"emails": {
										"value": "@pipeline().globalParameters.email",
										"type": "Expression"
									},
									"pipeline_start_time": {
										"value": "@pipeline().TriggerTime",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "process_pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "validation_pipeline",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "process_pipeline",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"env": {
										"value": "@pipeline().globalParameters.env",
										"type": "Expression"
									},
									"pipeline_start_time": {
										"value": "@pipeline().TriggerTime",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "delete_pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "delete_import",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						}
					]
				}
			},
			{
				"name": "SetCheckStartTime",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "check_start_time",
					"value": {
						"value": "@addHours(pipeline().TriggerTime, -24)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "notification",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "HasNewFile",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "MSME_ADF_ALERT",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"dataFactorySubscription": "5ddbd207-7e27-40a2-bd8c-829c651ebd12",
						"dataFactoryResourceGroup": "rg-SF-MSME-PROD",
						"pipelineRunId": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"teamsWebhookUrl": "https://teletechinc.webhook.office.com/webhookb2/a4c9892f-f273-4e",
						"activityName": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"activityMessage": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"activityDuration": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"activityStatus": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"ActivityStarttime": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						}
					}
				}
			}
		],
		"concurrency": 1,
		"variables": {
			"check_start_time": {
				"type": "String"
			}
		},
		"folder": {
			"name": "import"
		},
		"annotations": [],
		"lastPublishTime": "2025-07-07T20:42:48Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}