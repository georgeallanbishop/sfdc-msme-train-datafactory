									"modifiedDatetimeEnd": {
										"value": "@variables('cutoff_date')",
										"type": "Expression"
									},
									"wildcardFileName": {
										"value": "*",
										"type": "Expression"
									},
									"enablePartitionDiscovery": false
								}
							}
						},
