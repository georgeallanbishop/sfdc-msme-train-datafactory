					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "cutoff_date",
					"value": {
						"value": "@adddays(startOfDay(pipeline().TriggerTime), -10)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForFolder",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "SetCutoffDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.folders",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "DeleteInbound",
							"type": "Delete",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "sftp_inbound_archive",
