											"value": "@pipeline().globalParameters.env",
											"type": "Expression"
										},
										"folder": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								},
								"logStorageSettings": {
									"linkedServiceName": {
										"referenceName": "SFDC_storage_gen2",
										"type": "LinkedServiceReference"
									},
									"path": "auditlogs/delete_log"
